<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application>
    <!--
      Runs OtelZoneInitializer before Application.onCreate, so the JVM crash
      handler is installed before any app code runs and a crash during startup
      is still captured.

      The authority is androidx.startup's own, and tools:node="merge" is what
      makes that work: androidx.lifecycle declares this same provider, and two
      declarations with the same name but different authorities are a manifest
      merger error. Merging folds our meta-data into the one provider the app
      already has.
    -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="com.vaam.otel_zone.OtelZoneInitializer"
        android:value="androidx.startup" />
    </provider>
  </application>
</manifest>
